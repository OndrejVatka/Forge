# forge-ops environment. Copy to `forge-ops/.env` (gitignored) and fill in.
# These are PRODUCTION credentials on your machine only: never commit them,
# never paste them into a ticket or a chat.

# Production database. In Supabase: Project Settings → Database → Connection
# string → "Session pooler" (port 5432). The transaction pooler (6543) breaks
# pg_dump, and the direct host is IPv6-only on the free tier.
FORGE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Scratch Supabase project used by `make restore-test`. Restoring DROPS and
# recreates everything in the dump, so this must never be production; the
# tool refuses if it matches FORGE_DB_URL.
FORGE_RESTORE_DB_URL=postgresql://postgres.<scratch-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Deployed MCP server, without a trailing /mcp.
FORGE_MCP_URL=https://forgemcp-production.up.railway.app

# A production agent key for the smoke test (read-only calls only).
FORGE_SMOKE_API_KEY=

# Where backups go. Default: ~/Backups/forge. Keep it outside the repo.
# FORGE_BACKUP_DIR=

# Retention: backups older than RETENTION_DAYS are pruned after each backup,
# but the newest KEEP_MIN are always kept, however old.
# FORGE_BACKUP_RETENTION_DAYS=30
# FORGE_BACKUP_KEEP_MIN=10

# GitHub commit-status contexts that must succeed before a deploy counts as live.
# FORGE_DEPLOY_STATUS_CONTEXTS=Vercel,Forge - @forge/mcp

# Directory holding pg_dump/pg_restore/psql. Default: Homebrew's libpq, then PATH.
# PG_BIN=/opt/homebrew/opt/libpq/bin
