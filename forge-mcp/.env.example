# Forge MCP server environment.
# Copy to `.env` for local dev (loaded via dotenv). In production (Railway),
# set these in the dashboard under Variables — do NOT commit real values.

# Port the HTTP server listens on.
PORT=3000

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Service role key (server-side only — bypasses RLS). Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# One secret per agent. Each agent sends its own as `Authorization: Bearer <key>`,
# and the key a request presents decides how its tickets and comments are
# attributed, so an agent cannot claim to be another one, and you can revoke
# one agent without disturbing the others.
#
# Generate a separate long random value for each, e.g. `openssl rand -hex 32`.
# Reusing one secret for two identities is a startup error rather than a silent
# guess. Set only the agents you run; at least one key is required.
#
# These values guard your LOCAL server only. The deployed server has its own,
# set in the Railway dashboard, and the two must never share a secret. An agent
# pointed at the Railway URL needs the Railway key, not this one; mixing them up
# produces a bare 401.
FORGE_API_KEY_CLAUDE_CODE=generate-a-long-random-secret
FORGE_API_KEY_CODEX=generate-a-separate-secret
FORGE_API_KEY_HERMES=generate-a-third-secret

# Optional shorthand for a single-agent install: one key that writes as
# `claude-code`. Every agent that shares it is logged as claude-code, so once
# you run more than one agent, use the per-agent keys above instead.
# FORGE_API_KEY=generate-a-long-random-secret
