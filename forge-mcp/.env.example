# Forge MCP server environment.
# Copy to `.env` for local dev (loaded via dotenv). In production (Railway),
# set these in the dashboard under Variables — do NOT commit real values.

# Port the HTTP server listens on.
PORT=3000

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Service role key (server-side only — bypasses RLS). Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret Claude Code / Codex send as `Authorization: Bearer <key>`.
# Generate a long random value, e.g. `openssl rand -hex 32`.
FORGE_API_KEY=generate-a-long-random-secret
