# Forge MCP server environment.
# Copy to `.env` for local dev (loaded via dotenv). In production (Railway),
# set these in the dashboard under Variables — do NOT commit real values.

# Port the HTTP server listens on.
PORT=3000

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Service role key (server-side only — bypasses RLS). Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret your agents send as `Authorization: Bearer <key>`.
# Generate a long random value, e.g. `openssl rand -hex 32`.
#
# This value guards your LOCAL server only. The deployed server has its own,
# set in the Railway dashboard — an agent pointed at the Railway URL needs
# that one, not this one. Mixing them up produces a bare 401.
#
# A caller presenting this key writes as `claude-code`.
FORGE_API_KEY=generate-a-long-random-secret

# Optional: give each agent its own key, one variable per agent. The key a
# request presents decides how its tickets and comments are attributed, so an
# agent cannot claim to be another one — and you can revoke one agent without
# disturbing the others.
#
# One variable per identity: FORGE_API_KEY_CLAUDE_CODE, FORGE_API_KEY_CODEX,
# FORGE_API_KEY_HERMES. Generate a separate secret for each; reusing one
# secret for two identities is a startup error rather than a silent guess.
# Set these instead of FORGE_API_KEY, or alongside it.
#
# FORGE_API_KEY_HERMES=generate-a-separate-secret
