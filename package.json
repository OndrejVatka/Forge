{
  "name": "forge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "AI-native Kanban project management for Claude Code & Codex",
  "license": "MIT",
  "workspaces": [
    "forge-shared",
    "forge-mcp",
    "forge-ui"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "engines": {
    "node": ">=20"
  }
}
